{
  "name": "@genoffice/docs",
  "productName": "Codexoffice Docs",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI-native streaming docx editor with paragraph-patch save",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "node ../../tools/gen-third-party-notices.mjs && electron-vite build && electron-builder --config electron-builder.cjs --mac",
    "dist:win": "node ../../tools/gen-third-party-notices.mjs && electron-vite build && electron-builder --config electron-builder.cjs --win",
    "dist:dir": "node ../../tools/gen-third-party-notices.mjs && electron-vite build && electron-builder --config electron-builder.cjs --dir"
  },
  "devDependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/i18n": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/ai-search": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/file-parse": "*",
    "@genoffice/project-store": "*",
    "@genoffice/ui": "*",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "41.10.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "author": "Codexoffice contributors",
  "dependencies": {
    "@genoffice/electron-utils": "*",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1"
  }
}
